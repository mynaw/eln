# ---------------------------------------------------------------
# 运行期数据：绝对不能进版本库
# 实验记录、附件、账户哈希与会话密文都在这几项里
# ---------------------------------------------------------------
eln.db
eln.db-journal
eln.db-wal
eln.db-shm
accounts.json
.session
users/
attachments/
cas_cache.json
error.log
selftest-result.txt
firewall_log.txt
# 界面偏好（每台机器不同，程序缺省会自己重建）
ui_settings.json

# 本机快捷方式（含绝对路径，换机器即失效，用 make_shortcut.py 重建）
*.lnk

# 本机配置（含环境相关的路径与口令，绝不进版本库）
#   _local.json 里可放 {"web_token": "..."} 固定局域网访问口令；
#   提交到 GitHub 的永远是「不固定口令」的版本。
_local.*

# ---------------------------------------------------------------
# Python / 构建产物
# ---------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
build/
dist/
*.egg-info/
.venv/
venv/
.idea/
.vscode/
_backups/

# ---------------------------------------------------------------
# Ketcher 前端：源码与构建产物入库，依赖与日志不入库
# ---------------------------------------------------------------
vendor/ketcher-app/node_modules/
vendor/ketcher-app/npm-install*.log
vendor/ketcher-app/build.log
.ketcher-profile/

# Ketcher 的 dist 是随程序分发的构建产物（上面全局忽略了 dist/，这里放行）
!vendor/ketcher-app/dist/
!vendor/ketcher-app/dist/**

# 发布打包中间产物（构建输出、压缩包）
_release/
